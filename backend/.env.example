# ========================================================
# Aethera AI Backend - Production & Development Config
# ========================================================

# Active LLM Provider: 'groq' (Recommended, Free & Ultra-Fast) or 'gemini'
LLM_PROVIDER=groq

# 1. Groq Configuration (Get free key from https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# 2. Google Gemini Configuration (Optional, from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Database Configuration
# Local SQLite default: sqlite:///./aethera.db
# Production PostgreSQL (Railway / Neon / Supabase): postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./aethera.db

# CORS Allowed Origins (Comma-separated URLs for frontend)
BACKEND_CORS_ORIGINS=http://localhost:3000,https://your-frontend.vercel.app

# Port (configured automatically by Railway/Render via $PORT)
PORT=8000
